# Google API Key for Gemini embeddings (required to index documents for RAG)
GOOGLE_API_KEY=your-gemini-api-key-here

# Local LLM used to answer chat questions. Any OpenAI-compatible server works.
# Ollama default: http://127.0.0.1:11434/v1 with a pulled model such as llama3.2.
# Docker Compose reaches a host Ollama server at http://host.docker.internal:11434/v1.
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_LLM_MODEL=llama3.2

# Flask Configuration
FLASK_ENV=production

# CORS Origins (comma-separated, for production frontends)
# Add your Vercel domain and any other domains that need access
# Example: CORS_ORIGINS=https://your-app.vercel.app,https://www.your-domain.com
# For ResShare: CORS_ORIGINS=https://res-share-deployable.vercel.app
CORS_ORIGINS=https://res-share-deployable.vercel.app
FLASK_SECRET_KEY="secret_key_here"
# Optional: Override default Flask port
# FLASK_RUN_PORT=5000
STORAGE_TYPE=memory
KV_SERVICE_URL="https://crow.resilientdb.com"

# Qdrant Vector Database Configuration
# Compose uses http://qdrant:6333; a backend run on the host uses http://localhost:6333.
# Set QDRANT_VECTOR_DB_URL only when Qdrant runs at a different address.
