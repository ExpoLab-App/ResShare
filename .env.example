# Google API Key for Gemini (required for RAG chat functionality)
GOOGLE_API_KEY=your-gemini-api-key-here

# Flask Configuration
FLASK_ENV=production

# CORS Origins (comma-separated, for production frontends)
# Add your Vercel domain and any other domains that need access
# Example: CORS_ORIGINS=https://your-app.vercel.app,https://www.your-domain.com
# For ResShare: CORS_ORIGINS=https://res-share-deployable.vercel.app
CORS_ORIGINS=https://res-share-deployable.vercel.app
FLASK_SECRET_KEY="secret_key_here"
# Optional: Override default Flask port
# FLASK_RUN_PORT=5000
STORAGE_TYPE=memory
KV_SERVICE_URL="https://crow.resilientdb.com"

# ResShare MCP server (local stdio; used by python -m mcp_server.server)
RESSHARE_API_BASE_URL=http://127.0.0.1:5000
RESSHARE_USERNAME=your-username
RESSHARE_PASSWORD=your-password